                    "Authentication"
                ],
                "summary": "Login pengguna",
                "operationId": "1486dc0e281b126982243d7ced5e2806",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "android"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login berhasil"
                    },
                    "401": {
                        "description": "API key tidak valid"
                    },
                    "422": {
                        "description": "Kredensial atau input tidak valid"
                    }
                },
                "security": [
                    {
                        "RouterApiKey": []
                    }
                ]
            }
        },
