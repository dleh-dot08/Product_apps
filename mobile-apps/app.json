{
  "expo": {
    "name": "mobile-apps",
    "slug": "driverapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.frrama77steam.driverapps"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Applikasi ini membutuhkan akses lokasi di latar belakang untuk memantau perjalanan driver saat sedang bertugas.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi ini membutuhkan akses galeri agar Anda dapat mengunggah struk atau bukti foto dari memori HP.",
          "cameraPermission": "Aplikasi ini membutuhkan akses kamera agar Anda dapat mengambil foto bukti serah terima dan kondisi barang secara langsung."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71baecf7-0803-4399-b427-0faf85a71895"
      }
    },
    "owner": "frrama77s-team",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/71baecf7-0803-4399-b427-0faf85a71895"
    }
  }
}